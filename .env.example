OPENAI_API_KEY=your-api-key
# LangChain ChatOpenAI uses this optional endpoint and default model.
# OPENAI_API_BASE is also recognized when OPENAI_BASE_URL is unset.
# OPENAI_BASE_URL=https://your-endpoint.example/v1
# OPENAI_MODEL=gpt-6-luna
# Default requests use a 120-second timeout and two retries.
